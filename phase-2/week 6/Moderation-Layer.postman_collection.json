  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Moderate - ALLOW",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Please summarize this customer request.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/moderate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "moderate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Allowed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().decision).to.eql('ALLOW'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Moderate - MASK Secret Assignment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"password = \\\"abcdef123456\\\"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/moderate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "moderate"
          ]
        },
        "description": "Expected: HTTP 200, decision MASK, safe true, content <SECRET_MASKED>."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Decision is MASK', function () { pm.expect(pm.response.json().decision).to.eql('MASK'); });",
              "pm.test('Secret is sanitized', function () { pm.expect(pm.response.json().content).to.eql('<SECRET_MASKED>'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
