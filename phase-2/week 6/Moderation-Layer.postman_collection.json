{
  "info": {
    "_postman_id": "756441a3-6035-4d8b-8943-134eb89fc364",
    "name": "Deterministic Moderation Layer",
    "description": "Production moderation endpoint plus component diagnostic APIs from Architecture.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
